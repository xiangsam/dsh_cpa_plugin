{
  "name": "@xiangsam/dsh-cpa-plugin",
  "description": "dsh LLM adapter for MacCLIProxyAPI (CPA) \u2014 routes DeepSeek/subscription models through the local CPA unified endpoint, with 7-level thinking effort and a live context-cap setting the composer slider controls. Requires dsh >= 0.2.0-rc.2 (verified on 0.2.0-rc.2)",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiangsam/dsh_cpa_plugin.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "compatibility": {
      "tested": [
        "0.2.0-rc.2"
      ],
      "range": ">=0.2.0-rc.2 <0.3.0-0"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm-adapter",
    "maccliproxyapi",
    "dsh-0.2.0-rc.2"
  ],
  "license": "MIT",
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-timeout": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-anonymous-user-id": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
